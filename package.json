{
  "name": "cucm-availability-dashboard",
  "version": "1.0.0",
  "description": "Dashboard to visualize CUCM Call Manager Group failover impact",
  "type": "module",
  "scripts": {
    "dev": "DISABLE_POLLER=true tsx watch server/index.ts & cd client && npx vite --clearScreen false",
    "dev:full": "tsx watch server/index.ts & cd client && npx vite --clearScreen false",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "sync": "tsx server/scripts/sync.ts",
    "docker:build": "docker build -t cucm-availability .",
    "docker:run": "docker run -p 3000:3000 --env-file .env -v cucm-data:/data cucm-availability"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cisco-axl": "^1.4.1",
    "cisco-risport": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "soap": "^1.1.0",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
